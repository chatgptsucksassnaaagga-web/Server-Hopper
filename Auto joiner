local function routeBrainrots(brainrots)
    if #brainrots == 0 then return end
    if lastWebhookJobId == game.JobId then return end
    
    local best = brainrots[1]
    local main = buildMainEmbed(brainrots)
    local hi = buildHighlightEmbed(brainrots)
    
    if best.MPS < 1e7 then
        queueWebhook(WEBHOOK_1M_10M, main, best.MPS)
    elseif best.MPS < 1e8 then
        queueWebhook(WEBHOOK_10M_100M, main, best.MPS)
        queueWebhook(WEBHOOK_HIGHLIGHTS, hi, best.MPS)
    else
        queueWebhook(WEBHOOK_100M_INF, main, best.MPS)
        queueWebhook(WEBHOOK_HIGHLIGHTS, hi, best.MPS)
    end
    
    task.spawn(processQueue)
    lastWebhookJobId = game.JobId
end

-- ULTRA-FAST SERVER HOPPING SYSTEM
local serverCache = {}
local lastCacheTime = 0
local CACHE_LIFETIME = 5

local function fetchServersBatch(cursor)
    return task.spawn(function()
        local url = "https://games.roblox.com/v1/games/"..PLACE_ID.."/servers/Public?sortOrder=Asc&limit=100"
        if cursor and cursor ~= "" then
            url = url .. "&cursor=" .. cursor
        end
        
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGetAsync(url, true))
        end)
        
        if success and result and result.data then
            return result.data, result.nextPageCursor
        end
        return {}, nil
    end)
end

local function getAllServers()
    local currentTime = tick()
    
    if serverCache.servers and currentTime - lastCacheTime < CACHE_LIFETIME then
        return serverCache.servers
    end
    
    local allServers = {}
    local cursor = ""
    local fetchTasks = {}
    local fetchedCount = 0
    
    -- Start initial batch
    table.insert(fetchTasks, fetchServersBatch(""))
    
    while #fetchTasks > 0 do
        for i = #fetchTasks, 1, -1 do
            if fetchTasks[i]:status() == "completed" then
                local servers, nextCursor = fetchTasks[i]:result()
                
                for _, server in ipairs(servers) do
                    if server.playing < server.maxPlayers and server.id ~= game.JobId then
                        table.insert(allServers, server)
                        fetchedCount = fetchedCount + 1
                        
                        if fetchedCount >= 500 then
                            break
                        end
                    end
                end
                
                if nextCursor and fetchedCount < 500 then
                    table.insert(fetchTasks, fetchServersBatch(nextCursor))
                end
                
                table.remove(fetchTasks, i)
            end
        end
        
        if fetchedCount >= 500 then
            break
        end
        
        task.wait(0.01)
    end
    
    -- Cache the results
    serverCache.servers = allServers
    lastCacheTime = currentTime
    
    return allServers
end

local function fastTeleport()
    while true do
        -- Scan brainrots first
        local brainrots = scanBrainrots()
        routeBrainrots(brainrots)
        
        -- Get servers
        local servers = getAllServers()
        
        if #servers > 0 then
            -- Sort by player count (prefer emptier servers)
            table.sort(servers, function(a, b)
                return a.playing < b.playing
            end)
            
            -- Try to teleport to first available server
            local success = false
            for i = 1, math.min(10, #servers) do
                local server = servers[i]
                task.spawn(function()
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(PLACE_ID, server.id, Players.LocalPlayer)
                    end)
                end)
                
                -- Wait briefly before trying next server
                task.wait(0.05)
                
                -- Check if we're still in the same server
                if game.JobId ~= server.id then
                    success = true
                    break
                end
            end
            
            if not success then
                -- Fallback to random teleport
                task.spawn(function()
                    pcall(function()
                        TeleportService:Teleport(PLACE_ID, Players.LocalPlayer)
                    end)
                end)
            end
        else
            -- No servers found, teleport to random
            task.spawn(function()
                pcall(function()
                    TeleportService:Teleport(PLACE_ID, Players.LocalPlayer)
                end)
            end)
        end
        
        -- Brief wait before next scan/hop
        task.wait(0.5)
    end
end

-- Start the ultra-fast server hopping system
task.spawn(fastTeleport)
