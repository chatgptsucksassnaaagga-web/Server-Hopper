local function buildHighlightEmbed(brainrots)
    local best = brainrots[1]
    local rest = {}
    for i=2,#brainrots do
        table.insert(rest, brainrots[i].Name.." — $"..formatNumber(brainrots[i].MPS).."/s")
    end
    return {
        title="Raven N+ | HighLights",
        color=0xFFD700,
        fields={
            {name="💰 Top Brainrot",value="```"..best.Name.." — $"..formatNumber(best.MPS).."/s```"},
            {name="🧱 Other Brainrots",value="```"..table.concat(rest,"\n").."```"}
        },
        timestamp=os.date("!%Y-%m-%dT%H:%M:%SZ")
