end

local function routeBrainrots(brainrots)
    if #brainrots == 0 then return end
    if lastWebhookJobId == game.JobId then return end
    local best = brainrots[1]
    local main = buildMainEmbed(brainrots)
    local hi = buildHighlightEmbed(brainrots)
    if best.MPS < 1e7 then
        queueWebhook(WEBHOOK_1M_10M, main, best.MPS)
    elseif best.MPS < 1e8 then
        queueWebhook(WEBHOOK_10M_100M, main, best.MPS)
        queueWebhook(WEBHOOK_HIGHLIGHTS, hi, best.MPS)
    else
        queueWebhook(WEBHOOK_100M_INF, main, best.MPS)
        queueWebhook(WEBHOOK_HIGHLIGHTS, hi, best.MPS)
    end
    processQueue()
    lastWebhookJobId = game.JobId
end

local teleportData = TeleportService:GetLocalPlayerTeleportData() or {}
local visitedServers = teleportData.visited or {}
visitedServers[game.JobId] = true

local HOP_MULTIPLIER = 1500
local serverIndex = 1
local serversCache = {}
local lastCacheTime = 0
local CACHE_DURATION = 10

local function getServersBatch(cursor)
    local url = "https://games.roblox.com/v1/games/"..PLACE_ID.."/servers/Public?sortOrder=Desc&limit=100"
    if cursor ~= "" then url = url.."&cursor="..cursor end
    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if success then
        return response.data or {}, response.nextPageCursor
    end
    return {}, nil
end

local function refreshServersCache()
    if tick() - lastCacheTime < CACHE_DURATION and #serversCache > 0 then
        return serversCache
    end
    local allServers = {}
    local cursor = ""
    for _=1,5 do
        local servers,nextCursor = getServersBatch(cursor)
        for _,server in ipairs(servers) do
            if server.id ~= game.JobId and not visitedServers[server.id] then
                table.insert(allServers, server)
            end
        end
        if not nextCursor then break end
        cursor = nextCursor
    end
    serversCache = allServers
    lastCacheTime = tick()
    return allServers
end

local function getNextUnvisitedServer()
    local servers = refreshServersCache()
    if #servers == 0 then return nil end
    local server = servers[serverIndex]
    serverIndex += 1
    if serverIndex > #servers then serverIndex = 1 end
    visitedServers[server.id] = true
    return server
end

local function rapidTeleport()
    while true do
        local brainrots = scanBrainrots()
        routeBrainrots(brainrots)
        local server = getNextUnvisitedServer()
        if server then
            TeleportService:TeleportToPlaceInstance(PLACE_ID, server.id, Players.LocalPlayer, {visited=visitedServers})
        else
            TeleportService:Teleport(PLACE_ID, Players.LocalPlayer)
        end
        task.wait(0.3)
    end
end

for i=1, math.ceil(HOP_MULTIPLIER / 100) do
    task.spawn(rapidTeleport)
end
