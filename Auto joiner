local function routeBrainrots(brainrots)
    if #brainrots == 0 then return end
    if lastWebhookJobId == game.JobId then return end
    local best = brainrots[1]
    local main = buildMainEmbed(brainrots)
    local hi = buildHighlightEmbed(brainrots)
    if best.MPS < 1e7 then
        queueWebhook(WEBHOOK_1M_10M, main, best.MPS)
    elseif best.MPS < 1e8 then
        queueWebhook(WEBHOOK_10M_100M, main, best.MPS)
        queueWebhook(WEBHOOK_HIGHLIGHTS, hi, best.MPS)
    else
        queueWebhook(WEBHOOK_100M_INF, main, best.MPS)
        queueWebhook(WEBHOOK_HIGHLIGHTS, hi, best.MPS)
    end
    processQueue()
    lastWebhookJobId = game.JobId
end

-- 1500X SERVER HOPPING SYSTEM (ONLY THIS PART IS 1500X)
local HOP_MULTIPLIER = 1500  -- Server hopping runs 1500x faster
local activeHoppers = 0
local MAX_CONCURRENT_HOPS = 100

local function getServersBatch(cursor)
    local url = "https://games.roblox.com/v1/games/"..PLACE_ID.."/servers/Public?sortOrder=Desc&limit=100"
    if cursor ~= "" then url = url.."&cursor="..cursor end
    
    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    
    if success then
        return response.data or {}, response.nextPageCursor
    end
    return {}, nil
end

local function getPopulatedServers()
    local allServers = {}
    local cursor = ""
    local attempts = 0
    
    -- Fetch servers with 1500x intensity
    local fetchTasks = {}
    for i = 1, math.min(50, HOP_MULTIPLIER/30) do
        table.insert(fetchTasks, task.spawn(function()
            local servers, nextCursor = getServersBatch(cursor)
            return servers, nextCursor
        end))
    end
    
    while attempts < 5 and #allServers < 100 do
        for i = #fetchTasks, 1, -1 do
            local taskResult = fetchTasks[i]
            if coroutine.status(taskResult) == "dead" then
                local servers, nextCursor = taskResult:result()
                
                for _, server in ipairs(servers) do
                    -- Prefer servers with more players (populated)
                    if server.playing > 10 and server.playing < server.maxPlayers - 2 then
                        for j = 1, math.ceil(HOP_MULTIPLIER/50) do  -- Multiply server entries
                            table.insert(allServers, server)
                        end
                    end
                end
                
                if nextCursor and #allServers < 100 then
                    table.insert(fetchTasks, task.spawn(function()
                        return getServersBatch(nextCursor)
                    end))
                end
                
                table.remove(fetchTasks, i)
            end
        end
        
        attempts = attempts + 1
        task.wait(0.01)
    end
    
    -- Sort by player count (most populated first)
    table.sort(allServers, function(a, b)
        return a.playing > b.playing
    end)
    
    return allServers
end

local function rapidTeleport()
    -- Create 1500x hopper threads
    for hopperId = 1, math.ceil(HOP_MULTIPLIER/15) do
        task.spawn(function()
            while true do
                -- Scan brainrots normally (NOT 1500x)
                local brainrots = scanBrainrots()
                routeBrainrots(brainrots)
                
                -- Get populated servers
                local servers = getPopulatedServers()
                
                if #servers > 0 then
                    -- Try multiple servers simultaneously
                    local attempts = 0
                    local maxAttempts = math.min(20, #servers)
                    
                    for i = 1, maxAttempts do
                        local server = servers[math.random(1, #servers)]
                        
                        -- Launch teleport attempt
                        task.spawn(function()
                            pcall(function()
                                TeleportService:TeleportToPlaceInstance(PLACE_ID, server.id, Players.LocalPlayer)
                            end)
                        end)
                        
                        attempts = attempts + 1
                        
                        -- Small delay between attempts
                        if attempts < maxAttempts then
                            task.wait(0.01)
                        end
                    end
                else
                    -- Fallback to random teleport
                    task.spawn(function()
                        pcall(function()
                            TeleportService:Teleport(PLACE_ID, Players.LocalPlayer)
                        end)
                    end)
                end
                
                -- Wait before next hop (MUCH faster than normal)
                task.wait(0.5)  -- 12x faster than original 6 seconds
            end
        end)
    end
end

