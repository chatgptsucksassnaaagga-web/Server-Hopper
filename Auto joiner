local function sendToWebhook(webhookUrl, embed)
    if teleportData.reportedServers[game.JobId] then return end
    teleportData.reportedServers[game.JobId] = true
    pcall(function()
        local payload = {embeds = {embed}}
        local jsonPayload = HttpService:JSONEncode(payload)
        request({Url = webhookUrl, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonPayload})
    end)
end

local function executeServerHop()
    local currentJobId = game.JobId
    
    local servers = {}
    local success, data = pcall(function()
        local response = request({
            Url = "https://games.roblox.com/v1/games/" .. PLACE_ID .. "/servers/Public?sortOrder=Desc&limit=100",
            Method = "GET"
        })
        if response.Success then
            return HttpService:JSONDecode(response.Body)
        end
        return nil
    end)
    
    if success and data and data.data then
        servers = data.data
    end
    
    local availableServers = {}
    
    for _, server in ipairs(servers) do
        if server.id ~= currentJobId then
            local isVisited = teleportData.visitedServers[server.id]
            if not isVisited and server.playing < server.maxPlayers then
                availableServers[#availableServers + 1] = server
            end
        end
    end
    
    if #availableServers > 0 then
        table.sort(availableServers, function(a, b) return a.playing > b.playing end)
        local targetServer = availableServers[1]
        teleportData.visitedServers[targetServer.id] = true
        
        task.wait(1)
        TeleportService:TeleportToPlaceInstance(PLACE_ID, targetServer.id, Players.LocalPlayer, teleportData)
        return true
    else
        teleportData.visitedServers = {}
        teleportData.visitedServers[currentJobId] = true
        
        task.wait(2)
        TeleportService:Teleport(PLACE_ID, Players.LocalPlayer, teleportData)
        return false
    end
end

local function processBrainrots()
    local brainrots = scanBrainrots()
    if #brainrots > 0 then
        local categories = categorizeResults(brainrots)
        
        if #categories["1M - 10M"] > 0 then
            local embed = buildEmbed(categories["1M - 10M"], "1M - 10M")
            if embed then sendToWebhook(Webhook1M, embed) end
        end
        
        if #categories["10M - 100M"] > 0 then
            local embed = buildEmbed(categories["10M - 100M"], "10M - 100M")
            if embed then sendToWebhook(Webhook10M, embed) end
        end
        
        if #categories["100M - INF"] > 0 then
            local embed = buildEmbed(categories["100M - INF"], "100M - INF")
            if embed then sendToWebhook(Webhook100M, embed) end
        end
        
        if #categories["HIGHLIGHTS"] > 0 then
            local embed = buildHighlightEmbed(categories["HIGHLIGHTS"], brainrots)
            if embed then sendToWebhook(WebhookHighlights, embed) end
        end
        
        return true
    end
    return false
end

