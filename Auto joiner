local function formatNumber(num)
    if num >= 1e9 then return string.format("%.2fB", num / 1e9) end
    if num >= 1e6 then return string.format("%.2fM", num / 1e6) end
    if num >= 1e3 then return string.format("%.2fK", num / 1e3) end
    return tostring(num)
end

local function parseGeneration(text)
    if type(text) ~= "string" then return nil end
    local cleaned = text:lower():gsub("%$", ""):gsub("/s", ""):gsub(",", ""):gsub("%s+", "")
    local mult = 1
    local suffix = cleaned:sub(-1)
    if suffix == "k" then
        mult = 1e3
        cleaned = cleaned:sub(1, -2)
    elseif suffix == "m" then
        mult = 1e6
        cleaned = cleaned:sub(1, -2)
    elseif suffix == "b" then
        mult = 1e9
        cleaned = cleaned:sub(1, -2)
    end
    local num = tonumber(cleaned)
    if not num then return nil end
    return num * mult
end

local function scanBrainrots()
    local results = {}
    local children = Debris:GetChildren()
    for i = 1, #children do
        local item = children[i]
        if item.Name == "FastOverheadTemplate" then
            local overhead = item:FindFirstChild("AnimalOverhead")
            if overhead then
                local nameLabel = overhead:FindFirstChild("DisplayName")
                local genLabel = overhead:FindFirstChild("Generation")
                if nameLabel and genLabel and nameLabel:IsA("TextLabel") and genLabel:IsA("TextLabel") then
                    local mps = parseGeneration(genLabel.Text)
                    if mps and mps >= THRESHOLD then
                        results[#results + 1] = {
                            Name = nameLabel.Text or "Unknown",
                            MPS = mps,
                            Raw = genLabel.Text
                        }
                    end
                end
            end
        end
    end
    table.sort(results, function(a, b) return a.MPS > b.MPS end)
    return results
end

local function categorizeResults(results)
    local categories = {
        ["1M - 10M"] = {},
        ["10M - 100M"] = {},
        ["100M - INF"] = {},
        ["HIGHLIGHTS"] = {}
    }
    
    for i = 1, #results do
        local result = results[i]
        if result.MPS >= 1e8 then
            table.insert(categories["100M - INF"], result)
        elseif result.MPS >= 1e7 then
            table.insert(categories["10M - 100M"], result)
        elseif result.MPS >= 1e6 then
            table.insert(categories["1M - 10M"], result)
        end
        
        if result.MPS >= 5e8 then
            table.insert(categories["HIGHLIGHTS"], result)
        end
    end
    
    return categories
end

